  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 379faef6a95aa440781f3873babe4887, type: 3}
    m_FontSize: 50
    m_FontStyle: 0
    m_BestFit: 1
    m_MinSize: 1
    m_MaxSize: 100
    m_Alignment: 4
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "Our story begins in 1955, after the disaster that occurred during WWII,
    during which many lives were lost and numerous countries were disintegrated as
    a result of its consequences. Rebellions were everywhere; there was no good,
    just evil. \rI previously served in the USA and retired a couple of years ago.
    However, recently, I received a call from the Prime Minister recalling my duty
    once more due to the difficult situation the country was facing. \rHe told me
    that an organization calling itself the Sinister Society had successfully collected
    dangerous information that could threaten the nation and its future by starting
    another war that could affect the human race. These organization members escaped
    from the US Navy on a ship, but they eventually tracked them down. They landed
    on an island in the Pacific Ocean that was known only from ancient legends. This
    island contains a dangerous horde called The Seraphites, known for their savagery,
    especially towards foreign intruders. \n\n\n\n\n\n\nMy mission is to find and
    stop The Sinister Society, especially their leader Deathstroke, to prevent them
    from spreading the dangerous secrets and to overcome any obstacles I may face
    on this..."
